# ---------------------------------------------------------------------------
# Local research workspace (do not publish)
# ---------------------------------------------------------------------------
# These directories contain machine state, exploratory runs, private notes,
# cached datasets, and generated paper artifacts.  The public repository is
# reconstructed from source plus scripts/reproduce/; none of these paths is a
# source dependency.
/.claude/
/.codex/
/.codex_tmp/
/.mps_bypass/
/.pytest_cache/
/archive/
/artifacts/
/e0_lagsweep*/
/external/
/figs/
/figures/
/notes/
/plots/
/probe_inputs/
/probe_outputs/
/slurm_logs/
/temp/
/tmp/
/tmp_*

# Local maintenance history and generated manuscript snippets.
/docs/CODE_CLEANUP_*.md
/docs/appendix_training_time.tex
/docs/figure1_design_brief.*

# Root-level exploratory ledgers from development.  Stable, publishable tables
# belong under docs/ or are regenerated by scripts/reproduce/.
/*.csv
/*.json
/*.js
/*.npz
/*.tex
/.codex_*.tsv

# Host-specific launchers and monitoring/repair helpers remain available in
# this local checkout, but are intentionally not part of the GitHub surface.
# Generic, documented entry points live in scripts/reproduce/.
/scripts/launch_*
/scripts/queue_*
/scripts/resume_*
/scripts/status_*

# Public script allowlist.  Keeping this list explicit prevents one-off probes
# from silently entering a release when `git add .` is used.  Add a script here
# only when a documented reproduction entry point needs it.
/scripts/*
